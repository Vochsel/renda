# Public URL of this app (used for callback URLs, device verification links, MCP self-calls)
APP_URL=http://localhost:3000

# Postgres (Neon recommended)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# WorkOS AuthKit (dashboard) + User Management (agent magic-code signup)
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=at-least-32-characters-long-random-string
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=renda
R2_OUTPUT_TTL_SECONDS=86400

# Modal worker (see worker/README.md)
MODAL_SUBMIT_URL=https://<workspace>--renda-submit.modal.run
MODAL_CANCEL_URL=https://<workspace>--renda-cancel.modal.run
RENDA_WORKER_TOKEN=        # bearer token the server sends to the worker
RENDA_WORKER_SECRET=       # master HMAC secret; never sent to the worker. Each job gets HMAC(secret, "job:"+id) as its signing key
# Cloudflare API token (Account → Workers R2 Storage: Edit) used to mint per-job R2 temporary credentials
# scoped to outputs/<jobId>/ + work/<jobId>/, with R2_ACCESS_KEY_ID as the parent key. Required by the
# production worker (it holds no bucket key of its own); unset = jobs are sent without credentials (dev/tests).
CLOUDFLARE_API_TOKEN=
R2_JOB_CREDENTIAL_TTL_SECONDS=   # default 86400, max 604800
RENDA_ENGINE_VERSIONS=blender-4.5.14;mitsuba-3.6;three-0.180   # part of the result-cache key; bump on engine upgrades

# Stripe metered billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_METER_EVENT=render_seconds   # meters: render_seconds_cpu, render_seconds_gpu_l4, render_seconds_gpu_l40s
STRIPE_PRICE_CPU=price_...          # metered price on render_seconds_cpu ($0.015/min = $0.00025/s)
STRIPE_PRICE_GPU_L4=price_...       # $0.035/min
STRIPE_PRICE_GPU_L40S=price_...     # $0.075/min

# Analytics + error tracking (PostHog). Optional: unset = nothing is sent (self-hosting, previews, tests).
# Browser events go through the /ingest proxy; server events and API errors are sent from the server.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Free tier for new orgs, in seconds (default 1800 = 30 min)
FREE_SECONDS=1800

# Anonymous trials (POST /api/v1/auth/trial). Unset = conservative defaults; set your own in production.
TRIAL_SECONDS=
TRIAL_TTL_HOURS=
TRIAL_MAX_PER_NETWORK_PER_DAY=
TRIAL_MAX_DIMENSION=
TRIAL_IP_SALT=             # random string; keys the hashed-IP rate-limit table (falls back to RENDA_WORKER_SECRET)

# Rate limits (fixed window, Postgres-backed; see src/lib/ratelimit.ts for buckets + generic defaults).
# Each takes "count/seconds", e.g. RATE_LIMIT_MAGIC_START_IP=10/600. RATE_LIMIT_DISABLED=1 turns them off (dev).
RATE_LIMIT_MAGIC_START_IP=
RATE_LIMIT_MAGIC_START_EMAIL=
RATE_LIMIT_MAGIC_VERIFY_IP=
RATE_LIMIT_MAGIC_VERIFY_EMAIL=
RATE_LIMIT_DEVICE_START_IP=
RATE_LIMIT_DEVICE_TOKEN_IP=
RATE_LIMIT_DEVICE_APPROVE_USER=
RATE_LIMIT_API_WRITE_KEY=
RATE_LIMIT_DISABLED=

# Signs the client IP the remote MCP endpoint forwards to the API (falls back to RENDA_WORKER_SECRET).
RENDA_INTERNAL_SECRET=
# Accept worker events signed the old way (no x-renda-timestamp) while old worker containers drain.
# Set to 0 once the worker that sends timed signatures is fully deployed.
RENDA_ACCEPT_UNTIMED_WORKER_EVENTS=
# Accept worker events signed with the master RENDA_WORKER_SECRET (workers deployed before per-job keys).
# Set to 0 once the per-job-key worker is deployed and jobs submitted before it have finished.
RENDA_ACCEPT_MASTER_WORKER_EVENTS=

# Stale-job sweeper (Vercel Cron → /api/internal/sweep)
CRON_SECRET=
JOB_STALE_MINUTES=         # fail a job after this long with no worker event (default 15; the worker heartbeats every minute)
JOB_MAX_HOURS=             # hard cap on a job's runtime (default 6.5, past the worker's 6 h orchestrate timeout)

# Spend and concurrency limits
MAX_ACTIVE_JOBS_FREE=      # jobs running at once without a chargeable card (default 2)
MAX_ACTIVE_JOBS_PAID=      # default 20
DEFAULT_MONTHLY_LIMIT_USD= # monthly spend cap for workspaces that haven't set one (default 100)
FREE_OVERRUN_GRACE_SECONDS= # running time allowed past the free balance before a job is stopped (default 30)

# Public site URL used by install snippets (defaults to https://renda.vochsel.com)
NEXT_PUBLIC_SITE_URL=https://renda.vochsel.com
