def "_materials"
{
    def Material "table_wood"
    {
        token outputs:surface.connect = </_materials/table_wood/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (0.45, 0.3, 0.18)
            float inputs:ior = 1.45
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.6
            float inputs:specular = 0.5
            token outputs:surface
        }
    }

    def Material "gold_metal"
    {
        token outputs:surface.connect = </_materials/gold_metal/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (1, 0.72, 0.3)
            float inputs:ior = 1.45
            float inputs:metallic = 1
            float inputs:opacity = 1
            float inputs:roughness = 0.25
            float inputs:specular = 0.5
            token outputs:surface
        }
    }

    def Material "red_plastic"
    {
        token outputs:surface.connect = </_materials/red_plastic/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (0.8, 0.08, 0.06)
            float inputs:ior = 1.45
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.35
            float inputs:specular = 0.5
            token outputs:surface
        }
    }

    def Material "checker"
    {
        token outputs:surface.connect = </_materials/checker/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor.connect = </_materials/checker/Image_Texture.outputs:rgb>
            float inputs:ior = 1.45
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.5
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Image_Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/checker.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </_materials/checker/uvmap.outputs:result>
            float3 outputs:rgb
        }

        def Shader "uvmap"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "UVMap"
            float2 outputs:result
        }
    }

    def Material "blue_rough"
    {
        token outputs:surface.connect = </_materials/blue_rough/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (0.1, 0.25, 0.8)
            float inputs:ior = 1.45
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.8
            float inputs:specular = 0.5
            token outputs:surface
        }
    }
}

