{
  "$schema": "https://renda.dev/schema/v1.json",
  "version": 1,
  "name": "Splat turntable (.splat \u2192 MP4)",
  "scene": {
    "root": "../scenes/splats/garden.splat"
  },
  "camera": {
    "mode": "auto",
    "elevationDeg": 20,
    "padding": 0.02
  },
  "environment": {
    "background": "#f4f4f2"
  },
  "render": {
    "engine": "gsplat",
    "resolution": [
      720,
      720
    ]
  },
  "animation": {
    "frames": [
      1,
      48
    ],
    "fps": 24,
    "turntable": {
      "revolutions": 1
    }
  },
  "output": {
    "format": "mp4",
    "video": {
      "codec": "h264",
      "crf": 20
    }
  }
}
