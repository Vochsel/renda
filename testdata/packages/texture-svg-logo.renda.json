{
  "$schema": "https://renda.dev/schema/v1.json",
  "version": 1,
  "name": "SVG logo + AVIF/PSD/WebP textures by object name",
  "scene": {
    "root": "../scenes/scene.glb",
    "textureOverrides": [
      { "match": { "object": "CheckerCube" }, "source": "../textures/logo.svg" },
      { "match": { "object": "Sphere" }, "source": "../textures/oak.avif", "uv": { "scale": [2, 1] } },
      { "match": { "object": "Cylinder" }, "source": "../textures/oak_layer.psd" },
      { "match": { "material": "table_*" }, "source": "../textures/oak.webp", "uv": { "scale": 2 } }
    ]
  },
  "camera": { "mode": "auto", "elevationDeg": 25, "azimuthDeg": -30 },
  "environment": { "hdri": "studio", "background": "#efeee9" },
  "render": { "engine": "blender-eevee", "resolution": [720, 480], "quality": "standard" },
  "output": { "format": "png" }
}
