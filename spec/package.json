{
  "name": "@rendahq/spec",
  "version": "0.1.0",
  "description": "The Renda package format: typed JSON for render settings most 3D formats can't express.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./schema.json": "./schema/renda.v1.json"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p . && node scripts/gen-schema.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vochsel/renda.git",
    "directory": "spec"
  },
  "homepage": "https://renda.vochsel.com",
  "bugs": {
    "url": "https://github.com/Vochsel/renda/issues"
  },
  "keywords": [
    "renda",
    "3d",
    "rendering",
    "schema",
    "zod",
    "json-schema"
  ],
  "publishConfig": {
    "access": "public"
  }
}
