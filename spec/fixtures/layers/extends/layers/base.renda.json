{
  "version": 1,
  "name": "studio base",
  "assets": {
    "backdrop": { "uri": "../assets/cyc.glb" },
    "studio": { "uri": "../hdri/studio.hdr" }
  },
  "camera": { "mode": "auto", "elevationDeg": 18, "fovDeg": 30 },
  "environment": { "hdri": "studio", "intensity": 1.2, "background": "#f2f2f0" },
  "lights": [{ "type": "sun", "direction": [-1, -1, -1], "intensity": 2 }],
  "render": { "engine": "blender-cycles", "resolution": [1920, 1080], "quality": "standard" },
  "output": { "format": "png", "passes": ["beauty", "depth"] }
}
