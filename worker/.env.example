# Modal secret `renda-worker`: attached only to the submit/cancel endpoints.
RENDA_WORKER_TOKEN=        # bearer token web → worker (submit/cancel)
# RENDA_WORKER_SECRET is no longer read by the worker: each job brings its own signing key (jobKey) and
# R2 temporary credentials (storage) from the web app. The `renda-r2` secret is no longer used either.

# Deploy-time (exported when running ./deploy.sh; carried into containers as non-secret config)
POSTHOG_KEY=               # optional: job exceptions → PostHog error tracking (write-only ingestion key)

# Only for scripts/backfill_thumbs.py (runs on your machine, not in Modal)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=renda
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # optional override

# Only for scripts/submit_local.py remote mode
MODAL_SUBMIT_URL=https://<workspace>--renda-submit.modal.run
